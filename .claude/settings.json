{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "ask": [
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/os/lib/control/**)",
      "Edit(/os/control/**)",
      "Edit(/company/state/runtime/**)",
      "Edit(/os/tests/control-plane.test.mjs)",
      "Edit(/os/tests/migration.test.mjs)",
      "Edit(/os/tests/permissions.test.mjs)"
    ],
    "deny": [
      "mcp__claude_ai_*",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/client_secret*.json)",
      "Read(**/token*.json)",
      "Read(**/*credential*.json)",
      "Read(**/*credentials*.json)",
      "Read(**/service-account*.json)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "PowerShell(git push:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git remote:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git branch --delete --force:*)",
      "PowerShell(git tag -d:*)",
      "PowerShell(git tag --delete:*)"
    ]
  },
  "disableClaudeAiConnectors": true
}
